# Supabase project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Supabase anon/publishable key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase SERVICE ROLE key — bypasses Row Level Security. SERVER-ONLY.
# Must NOT be prefixed with NEXT_PUBLIC_ — it must never reach the browser.
# Used only in API routes, server actions, and server-only modules.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
